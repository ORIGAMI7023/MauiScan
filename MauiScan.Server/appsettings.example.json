{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "ScansDirectory": "data/scans",
    "MaxFileSizeMB": 20
  },
  "ApiKey": {
    "Enabled": true,
    "DefaultApiKey": "your-secret-api-key-change-me",
    "HeaderName": "X-API-Key",
    "_comment": "请修改 DefaultApiKey 为强密码，确保服务器安全"
  },
  "_notes": {
    "purpose": "服务器配置文件模板",
    "usage": "复制此文件为 appsettings.json 并修改 DefaultApiKey",
    "security": "appsettings.json 包含敏感信息，已添加到 .gitignore"
  }
}
