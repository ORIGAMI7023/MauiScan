<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiScan.Views.ScanPage"
             Title="文档扫描">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- 服务器连接状态 -->
        <HorizontalStackLayout Grid.Row="0" Spacing="6" Margin="0,0,0,10" HorizontalOptions="End">
            <Ellipse x:Name="ConnectionStatusDot"
                     WidthRequest="8"
                     HeightRequest="8"
                     Fill="Red"
                     VerticalOptions="Center"/>
            <Label x:Name="ConnectionStatusLabel"
                   Text="未连接"
                   FontSize="12"
                   TextColor="#666"
                   VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- 预览区域 -->
        <Border Grid.Row="1"
                StrokeThickness="2"
                Stroke="#512BD4"
                BackgroundColor="#F5F5F5"
                Margin="0,0,0,20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <Grid>
                <Image x:Name="PreviewImage"
                       Aspect="AspectFit"
                       IsVisible="False"/>

                <Label Text="点击下方按钮拍摄文档"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontSize="16"
                       TextColor="#999"
                       x:Name="PlaceholderLabel"/>

                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="#512BD4"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- 操作按钮 -->
        <VerticalStackLayout Grid.Row="2" Spacing="12">

            <!-- 扫描按钮 -->
            <Button x:Name="CaptureButton"
                    Text="📷 扫描文档"
                    Clicked="OnCaptureClicked"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="8"/>

            <!-- 手动标注按钮（仅 Android 识别失败时显示） -->
            <Button x:Name="ManualAnnotationButton"
                    Text="✍️ 手动标注文档边界"
                    Clicked="OnManualAnnotationClicked"
                    BackgroundColor="#FF9800"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="8"
                    IsVisible="False"/>

            <!-- 刷新按钮 -->
            <Button x:Name="RefreshButton"
                    Text="🔄 获取最新扫描"
                    Clicked="OnRefreshClicked"
                    BackgroundColor="#17A2B8"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="8"/>

            <!-- 保存按钮 -->
            <Button x:Name="SaveButton"
                    Text="💾 保存到本地"
                    Clicked="OnSaveClicked"
                    BackgroundColor="#28A745"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="8"
                    IsEnabled="False"/>

            <Label x:Name="StatusLabel"
                   Text=""
                   FontSize="12"
                   TextColor="#666"
                   HorizontalOptions="Center"
                   Margin="0,8,0,0"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
